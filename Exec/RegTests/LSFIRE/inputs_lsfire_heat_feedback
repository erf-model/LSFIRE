# ------------------  ERF + LSFIRE: fire heat and vapor fed back to ERF  -------------------
# erf.fire.coupling_type = lagged with ERF's default heat placement: the fluxes enter
# the source term of the step after the fire released them (ERF's one-step lag),
# spread over the column with the exponential profile (erf.fire.heat_flux_alfg = 45 m),
#   d(rho*theta)/dt = w_k Q / (Cp_d Pi dz),  d(rho*qv)/dt = w_k E / dz,
# with Pi the Exner function (erf.fire.heat_tendency_exner, on), w_k the share of the
# profile in cell k (sum over the column L = 1 - exp(-z_top/alfg)) and E = latent / L_v
# the vapour mass flux LSFIRE computes. erf.fire.fire_debug prints the energy ERF
# receives and injects at every RK stage, for the budget check in the README.
erf.prob_name = "ABL"
max_step = 1200               # 600 s
geometry.prob_extent = 6000 3000 400
amr.n_cell           = 60 30 4
geometry.is_periodic = 1 1 0
zlo.type = "NoSlipWall"
zhi.type = "SlipWall"
erf.fixed_dt = 0.5            # ERF compressible stable dt is ~0.85 s at dx = 100 m
erf.v = 2
amr.v = 0
amr.max_level = 0             # the fire couples to ERF level 0 only
erf.check_int = -1            # fire restart is not supported yet
erf.plot_file_1 = plt
erf.plot_int_1  = 1200
erf.plot_vars_1 = density rhotheta theta rhoQ1 fire_heat_flux fire_moisture_flux
erf.use_gravity = false
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.init_type = "uniform"
prob.rho_0 = 1.0
prob.T_0 = 300.0
prob.U_0 = 4.89
prob.V_0 = 0.0

# ---- fire ----
erf.fire.enable = 1
erf.fire.engine = lsfire
fire.mode = "atmospheric"
erf.fire.coupling_type = lagged
erf.fire.fire_debug = true
erf.fire.source_mode = add
erf.moisture_model = "MoistNoCondensation"   # vapor is only transported (clean budget)
erf.fire.grid_ratio = 10
erf.fire.plot_file = "fire_plt"
fire.fuel_model_source = "uniform"
fire.uniform_fuel_id = 102            # GR2
fire.fuel_database_path = "fuel_models.csv"
fire.wind_height = 10.0
fire.fuel_moisture_1hr = 0.03
fire.fuel_moisture_10hr = 0.03
fire.fuel_moisture_100hr = 0.03
fire.fuel_moisture_live_herb = 0.30
fire.fuel_moisture_live_woody = 0.60
fire.uniform_slope_x = 0.0
fire.uniform_slope_y = 0.0
fire.ignition_type = "point"
fire.ignition_x = 500.0
fire.ignition_y = 1500.0
fire.ignition_time = 0.0
fire.cfl = 0.9
fire.band_thickness = 5
fire.verbosity = 2            # prints the heat each fire update releases [J]
